# Local credentials (publish templates only)
.env
.env.*
!.env.template
!.env.tools.template
*.pem
*.key
credentials*.json

# Python, editable installs, and local environments
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
build/
dist/

# Research state and generated experiments; preserve locally
/data/*
/outputs/*
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log

# Downloaded third-party archives; restore explicitly when auditing sources
/evaluation/data/external/*
!/evaluation/data/external/README.md
/evaluation/data/research_v5/sources/*
!/evaluation/data/research_v5/sources/README.md

# Generated Word exports; Markdown is the maintained source
/docs/*.docx

# Editor and operating-system state
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Private notes and generated documentation stay local
/docs/
/data/
/outputs/
/PUBLIC_SNAPSHOT.json
/scripts/build_interview_docs.py
